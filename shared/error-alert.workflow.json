{
  "name": "D0 · error-alert",
  "nodes": [
    {
      "id": "65d0efb6-a7cd-4b86-9590-d2d674443e78",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "99f6afcb-ec82-4642-a3c8-84a05f128774",
      "name": "Email the error",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        260,
        0
      ],
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "=❌ {{ $json.workflow.name }} فشل",
        "emailType": "html",
        "message": "=<div dir=\"rtl\" style=\"font-family:Tahoma,Arial\"><b>Workflow:</b> {{ $json.workflow.name }}<br><b>Node:</b> {{ $json.execution.lastNodeExecuted }}<br><b>الخطأ:</b> {{ $json.execution.error.message }}<br><a href=\"{{ $json.execution.url }}\">افتح التنفيذ</a></div>",
        "options": {
          "appendAttribution": false
        }
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Email the error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Amman"
  }
